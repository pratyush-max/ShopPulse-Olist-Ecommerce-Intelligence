# ==============================================================================
# ShopPulse Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename the copy to '.env'
# 2. Fill in the values appropriate to your environment
# 3. DO NOT commit your actual '.env' file or any secrets to GitHub
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project Local Paths (Windows Development Environment)
# ------------------------------------------------------------------------------
PROJECT_ROOT=e:\ShopPulse
RAW_DATA_DIR=e:\ShopPulse\data\raw
GOLD_EXPORTS_DIR=e:\ShopPulse\data\gold_exports

# ------------------------------------------------------------------------------
# 2. Kaggle API Credentials (Optional - only if using automated Kaggle CLI)
# Alternatively, datasets can be downloaded manually via web browser
# ------------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# ------------------------------------------------------------------------------
# 3. Nager.Date Public API Configuration
# ------------------------------------------------------------------------------
NAGER_DATE_API_BASE_URL=https://date.nager.at/api/v3
HOLIDAY_COUNTRY_CODE=BR
HOLIDAY_YEARS=2016,2017,2018

# ------------------------------------------------------------------------------
# 4. Databricks Lakehouse Configuration
# ------------------------------------------------------------------------------
# Databricks host URL (e.g., https://adb-xxx.azuredatabricks.net or https://community.cloud.databricks.com)
DATABRICKS_HOST=https://your-databricks-instance.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_personal_access_token_here

# Storage Architecture: Unity Catalog Volumes (Standard in modern Databricks)
# Note: DBFS root (dbfs:/FileStore) is deprecated by Databricks.
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA_BRONZE=default
DATABRICKS_SCHEMA_SILVER=silver
DATABRICKS_SCHEMA_GOLD=gold
DATABRICKS_VOLUME_RAW=/Volumes/workspace/default/shoppulse_raw/

# ------------------------------------------------------------------------------
# 5. Databricks SQL Warehouse (For Direct Power BI Cloud Connection)
# ------------------------------------------------------------------------------
# Only applicable if using a Databricks Cloud Trial / Full Workspace with SQL Warehouses enabled.
# Leave blank if using Databricks Free Edition without SQL Warehouses (use Gold Parquet/CSV export).
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_PORT=443
